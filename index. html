<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>SB TOPUP 2</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, sans-serif;
      background: #0f172a;
      color: white;
      min-height: 100vh;
    }

    .navbar {
      background: #020617;
      padding: 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      position: sticky;
      top: 0;
      z-index: 1000;
      border-bottom: 1px solid #334155;
    }

    .logo {
      font-size: 20px;
      font-weight: bold;
    }

    .nav-links {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .nav-links a {
      color: white;
      text-decoration: none;
      font-weight: bold;
      font-size: 14px;
    }

    .nav-links a:hover {
      color: #22c55e;
    }

    header {
      background: linear-gradient(135deg, #14532d, #0f172a);
      text-align: center;
      padding: 35px 15px;
    }

    header h1 {
      font-size: 30px;
      margin-bottom: 8px;
    }

    header p {
      color: #cbd5e1;
    }

    .hero {
      text-align: center;
      padding: 55px 20px;
      background:
        radial-gradient(circle at top, rgba(34,197,94,.25), transparent 40%),
        #0f172a;
    }

    .hero h2 {
      font-size: 30px;
      margin-bottom: 15px;
    }

    .hero p {
      max-width: 600px;
      margin: auto;
      color: #cbd5e1;
      line-height: 1.7;
    }

    .button {
      display: inline-block;
      margin-top: 25px;
      padding: 14px 30px;
      background: #22c55e;
      color: white;
      text-decoration: none;
      border: 0;
      border-radius: 10px;
      font-weight: bold;
      cursor: pointer;
    }

    .button:hover {
      opacity: .85;
    }

    .services {
      padding: 25px 15px;
      max-width: 850px;
      margin: auto;
    }

    .services > h2 {
      text-align: center;
      margin-bottom: 20px;
    }

    .card {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 15px;
      padding: 22px;
      margin-bottom: 15px;
      text-align: center;
    }

    .card h3 {
      margin-bottom: 8px;
    }

    .card p {
      color: #cbd5e1;
      line-height: 1.6;
    }

    .package-card {
      background: linear-gradient(145deg, #1e293b, #172033);
      border: 1px solid #475569;
      border-radius: 18px;
      padding: 20px;
      margin: 15px 0;
      text-align: center;
    }

    .package-card h3 {
      font-size: 21px;
      margin-bottom: 10px;
    }

    .package-price {
      font-size: 20px;
      font-weight: bold;
      margin-bottom: 15px;
      color: #22c55e;
    }

    .order-btn {
      display: inline-block;
      padding: 11px 22px;
      background: #22c55e;
      color: white;
      text-decoration: none;
      border-radius: 10px;
      font-weight: bold;
    }

    form {
      text-align: left;
    }

    input,
    select {
      width: 100%;
      padding: 14px;
      margin: 8px 0 14px;
      border-radius: 10px;
      border: 1px solid #475569;
      background: #0f172a;
      color: white;
      font-size: 15px;
      outline: none;
    }

    input:focus,
    select:focus {
      border-color: #22c55e;
      box-shadow: 0 0 0 2px rgba(34,197,94,.15);
    }

    form .button {
      width: 100%;
      margin-top: 5px;
    }

    #orderMessage {
      margin-top: 15px;
      text-align: center;
      line-height: 1.6;
    }

    footer {
      margin-top: 30px;
      padding: 25px 15px;
      text-align: center;
      background: #020617;
      color: #94a3b8;
    }

    footer p {
      margin: 6px 0;
    }

    .ai-box {
      background: #111827;
    }

    @media (max-width: 600px) {
      .navbar {
        flex-direction: column;
      }

      .nav-links {
        width: 100%;
      }

      .hero h2 {
        font-size: 26px;
      }
    }
  </style>
</head>

<body>

