  <!-- SUPABASE ORDER SCRIPT -->
  <script>

    const SUPABASE_URL =
      "https://khspwaoavafwoqvtyaux.supabase.co";

    /*
      এখানে আপনার আগের Supabase Publishable Key বসান।
      আপনার আসল key কাউকে চ্যাটে পাঠাবেন না।
    */
    const SUPABASE_KEY =
      "sb_publishable_hq89AceCCRyKo2Y6NkpqMA_3JGo29Tp";


    const orderForm =
      document.getElementById("orderForm");

    const orderMessage =
      document.getElementById("orderMessage");


    orderForm.addEventListener("submit", async function(event) {

      event.preventDefault();


      const playerUID =
        document.getElementById("playerUID").value.trim();

      const customerName =
        document.getElementById("customerName").value.trim();

      const mobileNumber =
        document.getElementById("mobileNumber").value.trim();

      const packageName =
        document.getElementById("package").value;

      const paymentMethod =
        document.getElementById("paymentMethod").value;

      const transactionID =
        document.getElementById("transactionID").value.trim();


      if (
        !playerUID ||
        !customerName ||
        !mobileNumber ||
        !packageName ||
        !paymentMethod ||
        !transactionID
      ) {

        orderMessage.innerText =
          "⚠️ সব তথ্য পূরণ করুন।";

        return;
      }


      orderMessage.innerText =
        "⏳ Order পাঠানো হচ্ছে...";


      const order = {

        player_uid: playerUID,

        customer_name: customerName,

        mobile_number: mobileNumber,

        package_name: packageName,

        payment_method: paymentMethod,

        transaction_id: transactionID

      };


      try {

        const response = await fetch(

          SUPABASE_URL + "/rest/v1/orders",

          {

            method: "POST",

            headers: {

              "Content-Type":
                "application/json",

              "apikey":
                SUPABASE_KEY,

              "Authorization":
                "Bearer " + SUPABASE_KEY,

              "Prefer":
                "return=minimal"

            },

            body:
              JSON.stringify(order)

          }

        );


        if (!response.ok) {

          const errorText =
            await response.text();

          throw new Error(errorText);

        }


        orderMessage.innerText =
          "✅ Order সফলভাবে পাঠানো হয়েছে!";


        orderForm.reset();


      } catch (error) {

        console.error(error);

        orderMessage.innerText =
          "❌ Order পাঠানো যায়নি। আবার চেষ্টা করুন।";

      }

    });


    /* AI ASSISTANT */

    function askAI() {

      const question =
        document.getElementById("aiQuestion")
        .value
        .trim();

      const reply =
        document.getElementById("aiReply");


      if (!question) {

        reply.innerText =
          "⚠️ আগে আপনার প্রশ্ন লিখুন।";

        return;

      }


      reply.innerText =
        "🤖 SB AI: আপনার প্রশ্নটি পেয়েছি — \"" +
        question +
        "\"\n\n" +
        "বর্তমানে AI API সংযোগ করা হয়নি। " +
        "পরবর্তী ধাপে আসল AI API সংযোগ করা যাবে।";

    }

  </script>

</body>
