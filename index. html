<script>
function askAI() {
  const question = document.getElementById("aiQuestion").value.trim();
  const reply = document.getElementById("aiReply");

  if (!question) {
    reply.innerText = "⚠️ আগে আপনার প্রশ্ন লিখুন।";
    return;
  }

  reply.innerText =
    "🤖 SB AI: আপনার প্রশ্নটি পেয়েছি — \"" +
    question +
    "\"\n\nআসল AI API সংযোগ Part 7-এ করা হবে।";
}
</script>
