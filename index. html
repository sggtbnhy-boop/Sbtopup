<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>SB TOPUP 2</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: #0f172a;
      color: white;
      min-height: 100vh;
    }

    header {
      background: linear-gradient(135deg, #2563eb, #7c3aed);
      padding: 25px 15px;
      text-align: center;
    }

    header h1 {
      font-size: 30px;
      margin-bottom: 8px;
    }

    header p {
      font-size: 15px;
      color: #e0e7ff;
    }

    .hero {
      text-align: center;
      padding: 50px 20px;
    }

    .hero h2 {
      font-size: 28px;
      margin-bottom: 15px;
    }

    .hero p {
      color: #cbd5e1;
      line-height: 1.7;
      font-size: 16px;
    }

    .button {
      display: inline-block;
      margin-top: 25px;
      padding: 14px 30px;
      background: #22c55e;
      color: white;
      text-decoration: none;
      border-radius: 10px;
      font-weight: bold;
    }

    .services {
      padding: 20px;
    }

    .services h2 {
      text-align: center;
      margin-bottom: 20px;
    }

    .card {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 15px;
      padding: 22px;
      margin-bottom: 15px;
      text-align: center;
    }

    .card h3 {
      font-size: 20px;
      margin-bottom: 8px;
    }

    .card p {
      color: #cbd5e1;
    }

    footer {
      margin-top: 30px;
      padding: 20px;
      text-align: center;
      background: #020617;
      color: #94a3b8;
    }
  </style>
</head>

<body>

  <header>
    <h1>🔥 SB TOPUP 2</h1>
    <p>Fast • Easy • Trusted</p>
  </header>

  <section class="hero">
    <h2>Welcome to SB TOPUP 2</h2>

    <p>
      আপনার পছন্দের গেমের Top Up
      সহজেই করুন।
    </p>

    <a href="#services" class="button">
      TOP UP NOW
    </a>
  </section>

  <section class="services" id="services">

    <h2>🎮 Our Services</h2>
<h2>🔥 Free Fire Top Up</h2>
<a href="#" class="button">ORDER NOW</a>
<div class="card">
  <h3>💎 100 Diamonds</h3>
  <p>Price: ৳80</p>
  <a href="#" class="button">ORDER NOW</a>
</div>

<div class="card">
  <h3>💎 310 Diamonds</h3>
  <p>Price: ৳220</p>
  <a href="#" class="button">ORDER NOW</a>
</div>

<div class="card">
  <h3>💎 520 Diamonds</h3>
  <p>Price: ৳350</p>
  <a href="#" class="button">ORDER NOW</a>
</div>

<div class="card">
  <h3>💎 1060 Diamonds</h3>
  <p>Price: ৳700</p>
  <a href="#" class="button">ORDER NOW</a>
</div>
    <div class="card">
      <h3>💎 Game Top Up</h3>
      <p>দ্রুত ও সহজে Game Top Up করুন।</p>
    </div>

    <div class="card">
      <h3>⚡ Fast Service</h3>
      <p>সহজ এবং দ্রুত অর্ডার করার সুবিধা।</p>
    </div>

    <div class="card">
      <h3>🛒 Easy Order</h3>
      <p>কয়েকটি ধাপেই আপনার অর্ডার সম্পন্ন করুন।</p>
    </div>

  </section>

  <footer>
    © 2026 SB TOPUP 2
  </footer>
<section class="services" id="order">
<a href="#" class="button">ORDER NOW</a>
  <h2>🛒 Place Your Order</h2>

  <div class="card">

    <form>

      <input
        type="text"
        placeholder="Player UID"
        required
        style="width:100%;padding:14px;margin:8px 0;border-radius:8px;border:0;"
      >

      <input
        type="text"
        placeholder="আপনার নাম"
        required
        style="width:100%;padding:14px;margin:8px 0;border-radius:8px;border:0;"
      >

      <input
        type="tel"
        placeholder="Mobile Number"
        required
        style="width:100%;padding:14px;margin:8px 0;border-radius:8px;border:0;"
      >

      <select
        required
        style="width:100%;padding:14px;margin:8px 0;border-radius:8px;border:0;"
      >
        <option value="">Package নির্বাচন করুন</option>
        <option>100 Diamonds - ৳80</option>
        <option>310 Diamonds - ৳220</option>
        <option>520 Diamonds - ৳350</option>
        <option>1060 Diamonds - ৳700</option>
      </select>

      <select
        required
        style="width:100%;padding:14px;margin:8px 0;border-radius:8px;border:0;"
      >
        <option value="">Payment Method</option>
        <option>bKash</option>
        <option>Nagad</option>
        <option>Rocket</option>
      </select>

      <button
        type="submit"
        class="button"
        style="border:0;cursor:pointer;"
      >
        CONFIRM ORDER
      </button>

    </form>

  </div>

</section>
</body>
</html>
